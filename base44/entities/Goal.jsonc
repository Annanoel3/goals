{
  "name": "Goal",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The unique identifier of the goal"
    },
    "title": {
      "type": "string",
      "description": "The goal title, e.g. 'Learn Spanish'"
    },
    "description": {
      "type": "string",
      "description": "Full goal description and context from the user"
    },
    "plan_summary": {
      "type": "string",
      "description": "The AI-generated plan summary text"
    },
    "timeline": {
      "type": "string",
      "description": "Timeline description, e.g. '5 months', '1 year'"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "The user's chosen start date for the plan (YYYY-MM-DD)"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "description": "Target completion date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "paused"
      ],
      "default": "active",
      "description": "Current status of the goal"
    },
    "category": {
      "type": "string",
      "enum": [
        "learning",
        "health",
        "career",
        "finance",
        "relationships",
        "personal",
        "creative",
        "other"
      ],
      "default": "personal",
      "description": "Goal category"
    },
    "preferred_time": {
      "type": "string",
      "description": "Preferred time of day for action/workout (e.g., '6:00 AM', '18:30')",
      "default": null
    },
    "requires_daily_action": {
      "type": "boolean",
      "default": false,
      "description": "Whether this goal requires daily habits (AI-determined during plan creation)"
    },
    "weekdays_only": {
      "type": "boolean",
      "default": false,
      "description": "If true, daily habits only on weekdays (Mon-Fri); if false, 7 days/week (AI-determined during plan creation)"
    },
    "include_weekend_reminders": {
      "type": "boolean",
      "default": true,
      "description": "For daily action goals: whether to include weekend reminders (only relevant if requires_daily_action is true)"
    },
    "habit_days_of_week": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 6
      },
      "description": "Specific days for habits (0=Sun, 1=Mon, ... 6=Sat). If empty, follows weekdays_only logic.",
      "default": []
    },
    "reminder_interval": {
      "type": "string",
      "enum": [
        "15min",
        "30min",
        "1hour",
        "2hours"
      ],
      "description": "Follow-up reminder interval if action not completed (for health goals)",
      "default": "2hours"
    },
    "notification_frequency": {
      "type": "string",
      "description": "How often notifications should be sent for this goal (e.g., 'daily', 'weekdays', 'weekly', '3x_per_week', '2x_per_week', 'once_per_week')",
      "default": "daily"
    },
    "notes": {
      "type": "string",
      "description": "Personal notes about this goal"
    },
    "pictures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of image URLs attached to this goal",
      "default": []
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When goal was completed"
    },
    "conversation_history": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "The planning conversation history",
      "default": []
    },
    "onesignal_notification_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Scheduled OneSignal notification IDs for goal-level notifications (monthly summaries, etc.)",
      "default": []
    },
    "month_titles": {
      "type": "object",
      "description": "Map of month numbers to their descriptive titles (e.g. {1: 'Book Title', 2: 'Next Book Title'} for reading goals)",
      "default": {}
    },
    "notification_schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "check_in",
              "missed_follow_up",
              "week_summary_begin",
              "week_summary_end",
              "month_summary_begin",
              "month_summary_end"
            ]
          },
          "phase": {
            "type": "string"
          },
          "scheduled_date": {
            "type": "string",
            "format": "date"
          },
          "scheduled_time": {
            "type": "string"
          },
          "teaser_text": {
            "type": "string"
          },
          "full_message_text": {
            "type": "string"
          },
          "onesignal_notification_id": {
            "type": "string"
          },
          "has_been_displayed": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "id",
          "type",
          "phase",
          "scheduled_date",
          "scheduled_time",
          "teaser_text",
          "full_message_text"
        ]
      },
      "default": [],
      "description": "AI-generated notification schedule for the entire goal"
    },
    "timezone_offset_minutes": {
      "type": "number",
      "description": "User's timezone offset in minutes at time of goal creation (e.g. -300 for CDT)",
      "default": 0
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "system"
          }
        }
      ]
    }
  }
}
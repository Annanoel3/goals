{
  "name": "Goal",
  "type": "object",
  "properties": {
    "goal_id": {
      "type": "string",
      "description": "Self-referencing goal ID (mirrors the built-in id field for easy reference)"
    },
    "title": {
      "type": "string",
      "description": "The goal title, e.g. 'Learn Spanish'"
    },
    "description": {
      "type": "string",
      "description": "Full goal description and context from the user"
    },
    "plan_summary": {
      "type": "string",
      "description": "The AI-generated plan summary text"
    },
    "timeline": {
      "type": "string",
      "description": "Timeline description, e.g. '5 months', '1 year'"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "description": "Target completion date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "paused"
      ],
      "default": "active",
      "description": "Current status of the goal"
    },
    "category": {
      "type": "string",
      "enum": [
        "learning",
        "habit",
        "health",
        "career",
        "finance",
        "relationships",
        "personal",
        "creative",
        "other"
      ],
      "default": "personal",
      "description": "Goal category."
    },
    "preferred_time": {
      "type": "string",
      "description": "Preferred time of day for action/workout (e.g., '6:00 AM', '18:30')",
      "default": null
    },
    "reminder_interval": {
      "type": "string",
      "enum": [
        "15min",
        "30min",
        "1hour",
        "2hours",
        "1day"
      ],
      "description": "Follow-up reminder interval if action not completed (for health goals)",
      "default": "1day"
    },
    "notification_frequency": {
      "type": "string",
      "description": "How often notifications should be sent for this goal (e.g., 'daily', 'weekdays', 'weekly', '3x_per_week', '2x_per_week', 'once_per_week')",
      "default": "daily"
    },
    "notification_days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Specific days of week to send notifications (0=Sun, 1=Mon ... 6=Sat). Derived from the user's stated schedule (e.g. Mon/Wed/Fri runs = [1,3,5]). Overrides notification_frequency when set.",
      "default": null
    },
    "event_cadence": {
      "type": "string",
      "description": "For social/career/relationship/creative goals: the cadence of the recurring activity, e.g. 'weekly', 'biweekly', 'monthly'. Used to personalize notification timing.",
      "default": null
    },
    "event_format": {
      "type": "string",
      "description": "For social/career/relationship/creative goals: the type/format of recurring activity, e.g. 'team lunch', 'date night', 'weekly outing', 'monthly giveaway'. Used to personalize notification content.",
      "default": null
    },
    "notes": {
      "type": "string",
      "description": "Personal notes about this goal"
    },
    "pictures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of image URLs attached to this goal",
      "default": []
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When goal was completed"
    },
    "conversation_history": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "The planning conversation history",
      "default": []
    },
    "onesignal_notification_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Scheduled OneSignal notification IDs for goal-level notifications (monthly summaries, etc.)",
      "default": []
    },
    "month_titles": {
      "type": "object",
      "description": "Map of month numbers to their descriptive titles",
      "default": {}
    },
    "pending_notifications": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "AI-generated notification messages pending in-app display (week/month previews, summaries, and catch-up nudges)",
      "default": []
    },
    "building_months": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Month numbers still being created in the background. Null/empty when fully built.",
      "default": null
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}
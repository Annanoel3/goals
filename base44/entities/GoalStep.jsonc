{
  "name": "GoalStep",
  "type": "object",
  "properties": {
    "goal_id": {
      "type": "string",
      "description": "The parent goal ID"
    },
    "title": {
      "type": "string",
      "description": "Step/subtask title"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of this step"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium",
      "description": "Priority level of this step"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "skipped"
      ],
      "default": "pending"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "When this step should be completed"
    },
    "phase": {
      "type": "string",
      "description": "Which phase/month/week this step belongs to, e.g. 'Month 1', 'Week 3'"
    },
    "order_index": {
      "type": "number",
      "description": "Order within the goal plan",
      "default": 0
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "onesignal_notification_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Scheduled notification IDs for this step",
      "default": []
    },
    "notes": {
      "type": "string",
      "description": "Notes specific to this step"
    },
    "step_resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "video",
              "book",
              "article",
              "tool",
              "course",
              "website",
              "other"
            ],
            "description": "Type of resource"
          },
          "title": {
            "type": "string",
            "description": "Name of the resource"
          },
          "url": {
            "type": "string",
            "description": "Link to the resource"
          },
          "description": {
            "type": "string",
            "description": "Brief description or how to use it"
          },
          "specific_details": {
            "type": "string",
            "description": "Specific sections, times, pages, etc. (e.g., 'watch 2:30-5:45', 'read pages 45-52')"
          }
        },
        "required": [
          "type",
          "title"
        ]
      },
      "default": [],
      "description": "Resources needed for this specific step"
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Measurable indicators of completion (e.g., 'Can play scales at 60 bpm')"
    },
    "tips_and_guidance": {
      "type": "string",
      "description": "Specific advice, best practices, or common pitfalls to avoid"
    },
    "pictures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of image URLs attached to this step",
      "default": []
    }
  },
  "required": [
    "goal_id",
    "title"
  ],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}